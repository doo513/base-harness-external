{
  "schema_version": "implementation-completion-requirements-v1",
  "objective": "Complete the agreed Domain/Core/Verifier/Skill-helper/evaluation implementation tree",
  "requirements": [
    {"id":"domain.profiles", "implementation":["src/harness_external/domain.py","src/harness_external/acceptance.py"], "tests":["test_configured_policy_compiles_mandatory_checks_and_separates_authority"], "meaning":"Domain compiles explicitly registered profiles; metadata and semantics remain distinct"},
    {"id":"domain.requirement-links", "implementation":["src/harness_external/domain.py"], "tests":["test_file_only_mapping_cannot_claim_command_requirement"], "meaning":"Requirement links reference named mandatory checks and declare the required evidence kind"},
    {"id":"domain.exploration", "implementation":["src/harness_external/semantics.py"], "tests":["test_exploratory_failure_does_not_change_acceptance_or_disappear"], "meaning":"A failed exploratory probe remains a fact without changing acceptance"},
    {"id":"domain.limited-assurance", "implementation":["src/harness_external/evidence.py","src/harness_external/acceptance.py"], "tests":["test_weak_caller_check_is_not_presented_as_goal_or_command_verification"], "meaning":"Weak caller criteria are identified as such, not promoted to goal proof"},
    {"id":"core.separate-policy-input", "implementation":["src/harness_external/acceptance.py","src/harness_external/service.py"], "tests":["test_caller_cannot_downgrade_operator_policy","test_domain_compiler_cannot_drop_configured_mandatory_references","test_revision_rejects_domain_mandatory_reference_drift"], "meaning":"Configured references cannot be replaced by a caller mode or omitted by a Domain result"},
    {"id":"core.authorship-and-approval", "implementation":["src/harness_external/acceptance.py","src/harness_external/semantics.py"], "tests":["test_configured_authorship_is_not_inferred_from_generator_or_approver"], "meaning":"Criteria/test authors, Domain generator, configured approval and change authority are separate; none implies authenticated human approval"},
    {"id":"core.pinned-test-bundle", "implementation":["src/harness_external/acceptance.py","src/harness_external/snapshots.py"], "tests":["test_pinned_tests_ignore_changed_workspace_and_registry_copies","test_bundle_corruption_is_not_accepted"], "meaning":"Submitted tests and fixtures come from captured policy bytes, not editable workspace copies"},
    {"id":"core.immutable-scope", "implementation":["src/harness_external/domain.py","src/harness_external/service.py"], "tests":["test_revise_cannot_replace_acceptance_and_can_extend_inputs"], "meaning":"Mandatory command verification cannot be downgraded to file checks"},
    {"id":"core.linked-policy-change", "implementation":["src/harness_external/service.py"], "tests":["test_policy_replay_and_linked_revision_preserve_old_bundle"], "meaning":"Replacement Runs retain predecessor/policy/reason references and old usage/history"},
    {"id":"core.concurrent-capture", "implementation":["src/harness_external/service.py"], "tests":["test_concurrent_start_publishes_one_policy_and_baseline","test_start_capture_does_not_block_another_run_measurement"], "meaning":"Idempotent publication remains isolated without a global writer lock during file capture"},
    {"id":"verifier.scope-and-timeout", "implementation":["src/harness_external/evidence.py","runtime/script/external-harness-sandbox.ts"], "tests":["test_missing_baseline_and_unavailable_command_do_not_show_improvement","test_live_command_timeout_is_not_an_ordinary_exit_124"], "meaning":"Completed command, unavailable execution, timeout and test-case coverage are not conflated"},
    {"id":"verifier.baseline", "implementation":["src/harness_external/worker.py","src/harness_external/evidence.py"], "tests":["test_baseline_pairing_does_not_gate_on_original_failure","test_baseline_failure_cannot_satisfy_current_candidate_gate","test_scope_change_does_not_claim_pinned_bundle_is_missing"], "meaning":"Paired observations distinguish improvement/regression and explicit incomparability"},
    {"id":"verifier.controls-and-partial-facts", "implementation":["src/harness_external/worker.py","src/harness_external/store.py"], "tests":["test_live_acceptance_bundle_negative_and_positive_controls","test_interrupted_pair_preserves_baseline_without_satisfying_candidate","test_runtime_identity_cache_rehashes_a_changed_executable"], "meaning":"Actual Sandbox positive/negative controls and interrupted measurements retain correct binding"},
    {"id":"caller.binding-and-replay", "implementation":["skills/harness-workflow/scripts/harness_client.py"], "tests":["test_binding_reduces_context_input_but_rejects_changed_store_and_intent","test_serialized_request_roundtrip_and_payload_conflict","test_transport_lock_serializes_mutations_without_blocking_reads"], "meaning":"Explicit binding, saved requests and transport serialization reduce repeated protocol work without a second Run store"},
    {"id":"caller.mechanical-checkpoint", "implementation":["skills/harness-workflow/scripts/harness_client.py"], "tests":["test_checkpoint_is_mechanical_idempotent_and_does_not_finish","test_checkpoint_response_loss_replays_original_submission","test_checkpoint_refuses_superseding_candidate","test_wait_window_does_not_cancel_restart_or_call_a_model"], "meaning":"Submission/verification/wait mechanics do not decide assessment, repair or finish"},
    {"id":"skill.real-usage", "implementation":["skills/harness-workflow/SKILL.md","skills/harness-workflow/references/protocol.md"], "evidence":["evaluation/skill-forward-acceptance.json"], "meaning":"A separate same-Host agent used the Skill and produced retained fail-to-pass measurements; this is not a third-party audit"},
    {"id":"evaluation.model-scope-and-cost", "implementation":["scripts/agent_study.py","scripts/luna_study.py","scripts/report_agent_study.py"], "evidence":["evaluation/luna-agy-comparison.json"], "meaning":"18 Luna/AGY conditions, initial/final outcomes, recovery/repair, raw cost counters and policy consistency; unmeasured costs remain explicit"},
    {"id":"evaluation.integrity", "implementation":["scripts/study_scope.py","scripts/study_subject_driver.py","scripts/report_agent_study.py"], "tests":["test_driver_accepts_value_error_subclasses","test_live_scope_terminates_namespace_and_new_process_group","test_artifact_audit_detects_changes_and_added_importable_files","test_provider_rejection_is_not_an_artifact_repair_attempt","test_future_studies_use_only_luna_and_agy","test_base_runner_stops_preexecution_failure_for_either_host","test_report_requires_each_of_the_nine_conditions_once","test_report_rechecks_frozen_files_not_only_manifest_equality"], "meaning":"Grader controls, exact artifact identity, provider availability and descendant lifecycle are checked independently"},
    {"id":"architecture.model-free", "implementation":["src/harness_external","skills/harness-workflow/scripts/harness_client.py"], "tests":["test_external_package_has_no_host_ui_or_provider_imports","test_checkpoint_is_mechanical_idempotent_and_does_not_finish"], "meaning":"Production Harness remains model-free; only the opt-in evaluation runner launches model CLIs"}
  ],
  "explicit_nonclaims": [
    "A passing check is not a proof that the original goal is fully satisfied.",
    "Configured local approval is not authenticated human identity or same-user tamper resistance.",
